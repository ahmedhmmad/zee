# Device TCP gateway — must match the OCI ingress rule and the port
# written into each device with the P06 command.
GATEWAY_PORT=10001
GATEWAY_HOST=0.0.0.0

# Postgres. Kept on 127.0.0.1; never expose 5432.
DATABASE_URL=postgres://zee_app:CHANGE_ME@127.0.0.1:5432/zee

# Reject frames from device IDs not present in the devices table.
# Leave true in production: the protocol has no authentication, so an
# allowlist is the only thing standing between us and forged telemetry.
REQUIRE_KNOWN_DEVICE=true

# --- API and web UI ---------------------------------------------------------

# Loopback only: Nginx is the sole ingress. Never bind 0.0.0.0 here, or the
# app becomes reachable over plain HTTP, bypassing TLS.
API_PORT=3333
API_HOST=127.0.0.1

# Bootstrap credential, no longer a login path in its own right.
#
# Operators log in with named accounts (see `npm run user:add`). On the first
# start after named users landed, this value is turned into an account called
# "operator" so a live deployment is not locked out mid-rollout — after which it
# is unused. Create a named account per person and deactivate "operator": until
# you do, the audit trail cannot say who opened a valve.
AUTH_PASSWORD=CHANGE_ME

# Development only, and enforced: with AUTH_DISABLED=true the API refuses to
# start unless NODE_ENV=development, because it opens the console AND the
# unlock endpoint to anyone who can reach the port.
# NODE_ENV=development
# AUTH_DISABLED=true

# --- Sub-lock (JT709 valve) unlocking ---------------------------------------

# OFF by default, and it should stay off until a bench test says otherwise.
#
# A sub-lock unlock currently has no confirmation path: the WLNET,8 reply is a
# bare echo from the master with no success flag, and a sleeping JT709 reports
# nothing at all — so the platform cannot say whether a valve opened. Whether
# enabling the LoRa heartbeat provides that path is undocumented and untested
# (see the comment on wlnetSetHeartbeat in src/protocol/encode.ts).
#
# Master-lock unlocking is unaffected by this.
SUBLOCK_UNLOCK_ENABLED=false

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset a random secret is generated at boot, which logs everyone out on
# every restart.
COOKIE_SECRET=

LOG_LEVEL=info

# --- Capacity ---------------------------------------------------------------

# Connection pool size. Defaults to 25 in the gateway and 15 in the API, sized
# against a fleet-wide reconnect rather than the steady state. Postgres's own
# max_connections is the ceiling both must fit inside.
# DB_POOL_MAX=

# How many buffered positions ONE device may replay per second. A truck back
# from a four-hour coverage gap has ~480 to dump; uncapped, one backlog takes
# the pool and the trucks reporting live queue behind it. Nothing is dropped —
# the replay is paced, and the socket stays paused so it reaches the device as
# TCP backpressure. 0 disables the limit.
# GATEWAY_REPLAY_FRAMES_PER_SEC=20

# Tile proxy cache. Written by the API process, so it must be inside
# ReadWritePaths in the systemd unit.
TILE_CACHE_DIR=/home/zee/htdocs/locks.ahmedhammad.page/.cache/tiles

# Google Maps browser key. Optional: without it the UI uses the proxied
# OpenStreetMap basemap. Google has far better data for Libya, but their terms
# forbid proxying tiles, so browsers must reach Google directly.
# Restrict the key by HTTP referrer to https://locks.ahmedhammad.page/*
GOOGLE_MAPS_API_KEY=

# --- ArcGIS / Esri ----------------------------------------------------------

# API key from the client's own Esri licence, used to render their purchased
# basemap in this console. With it set, "إيسري" appears in the basemap picker
# and is selected by default.
#
# This draws OUR vehicle data (from our own JSON) on top of Esri's map. It does
# not publish anything into their ArcGIS Online organisation and creates no
# feature service.
#
# A browser key, so it is public by nature - every console that loads the map
# receives it. Restrict it by referrer in the ArcGIS Location Platform console.
# Esri keys also carry per-service scopes: a key without the basemap scope
# authenticates successfully and then serves no tiles, which presents as a
# broken map rather than as a permissions error.
ARCGIS_API_KEY=

# Which ArcGIS Maps SDK release to load from Esri's CDN. Configurable because
# Esri retires CDN versions on their own schedule, and when one goes the map
# breaks for everyone at once - this makes the fix an .env edit and a restart.
ARCGIS_VERSION=4.31

# --- Integration API --------------------------------------------------------

# Origins allowed to call /api/v1/* from a browser. Comma-separated, exact
# origins including the scheme (https://partner.example.ly), no trailing slash.
#
# Blank by default, which means no CORS headers at all and only server-to-server
# callers can use the feed. That is the arrangement to prefer, and the reason
# is not style:
#
#   A browser cannot hold a secret. Enabling this means the partner's page
#   carries the bearer token in its own JavaScript, where anyone who opens the
#   page source can read it — and with it, the live position of every tanker in
#   the fleet. The token is read-only, so what leaks is visibility, never
#   control of a valve. That is still a great deal to leak.
#
# The alternative costs the partner about ten lines: their server holds the
# token, calls us, and re-serves the JSON to their own page from their own
# origin. Then nothing crosses a browser.
#
# See docs/integration-api.md.
INTEGRATION_CORS_ORIGINS=

# --- Evaluation period ------------------------------------------------------

# Disclosed pilot term, not a hidden switch. On or after this date both the API
# and the device gateway stop serving and show an "evaluation period ended"
# notice. Set it to a later date (or blank) and restart the two services to
# resume — nothing is ever deleted, and the locks keep their state.
#
# Format: YYYY-MM-DD (the whole of that day is still inside the period).
# Blank or unset means no limit — an ordinary unlimited deployment.
# See README "Evaluation period" and src/evaluation.ts.
EVALUATION_EXPIRES_AT=
