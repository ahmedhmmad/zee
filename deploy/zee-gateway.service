[Unit]
Description=Zee JT701D device gateway
Documentation=https://locks.ahmedhammad.page
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=zee
WorkingDirectory=/home/zee/htdocs/locks.ahmedhammad.page
EnvironmentFile=/home/zee/htdocs/locks.ahmedhammad.page/.env
ExecStart=/usr/bin/node src/gateway/index.ts
Restart=always
# One file descriptor per connected device, plus the pool and the logs.
# Node raises RLIMIT_NOFILE from soft to hard at startup and systemd >= 240
# defaults to 1024:524288, so this is usually already fine — set explicitly so
# it does not depend on which systemd the box happens to run. Check the live
# value with:
#   cat /proc/$(systemctl show -p MainPID --value zee-gateway)/limits | grep "open files"
LimitNOFILE=65535

RestartSec=5

# Runs unprivileged: the gateway binds 10001, which is above 1024, so no
# capabilities are needed.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/zee/htdocs/locks.ahmedhammad.page

StandardOutput=journal
StandardError=journal
SyslogIdentifier=zee-gateway

[Install]
WantedBy=multi-user.target
