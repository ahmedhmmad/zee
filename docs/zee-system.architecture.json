      "labelDy": 70
    },
    {
      "id": "operator",
      "from": "console",
      "to": "nginx",
      "label": "HTTPS + WebSocket",
      "variant": "emphasis"
    },
    {
      "id": "integration",
      "from": "partner",
      "to": "nginx",
      "label": "HTTPS + bearer token",
      "variant": "security"
