  "cards": [
    {
      "dot": "cyan",
      "title": "Two processes, one database",
      "items": [
        "The gateway owns the truck sockets; the API owns the browsers",
        "They never call each other: the database announces every write"
      ]
    },
    {
      "dot": "emerald",
      "title": "One map, one shape",
      "items": [
        "MapLibre over proxied OpenStreetMap, no basemap picker",
        "The console reads the partner feed's fields plus the operator's own"
      ]
    },
    {
      "dot": "rose",
      "title": "What cannot cross",
      "items": [
        "The partner feed is read-only; unlocking stays with a named operator",
        "The device allowlist is the only authentication the TCP protocol has"
      ]
    }
  ]
