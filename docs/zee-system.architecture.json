{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "The Zee Lock Platform Today",
    "locale": "en",
    "output": "zee-system.html",
    "viewBox": [
      1040,
      400
    ],
    "quality_profile": "showcase",
    "views": [
      {
        "id": "device-path",
        "label": "The device path",
        "focus": [
          "sublock",
          "master",
          "gateway",
          "db"
        ],
        "note": "Raw TCP on its own port. No HTTP anywhere between a lock and the database."
      },
      {
        "id": "who-reads",
        "label": "Who reads the fleet",
        "focus": [
          "db",
          "api",
          "nginx",
          "console",
          "partner"
        ],
        "note": "One projection serves both readers: the console gets it pushed, the partner pulls it."
      },
      {
        "id": "one-way-in",
        "label": "One way in per caller",
        "focus": [
          "nginx",
          "api",
          "partner"
        ],
        "note": "A session cookie for people, a revocable bearer token for machines, and no write path for either."
      }
    ]
  },
